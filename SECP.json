      "parameters": {
        "jsCode": "// Guarda todos los items del último run en un array\nconst allItemsFromLastRun = items.map(item => item.json);\n\n// Envía el array como un único item al siguiente nodo\nreturn [\n  {\n    json: {\n      lastRunBatch: allItemsFromLastRun, // Todos los items del último run\n    }\n  }\n];"
      },
      "id": "ce226d49-80e9-46d8-b1dd-1a6fe0666667",
