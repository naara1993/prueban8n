      ],
      "id": "c4244567-f173-4b5f-80c8-5239643ccf82",
      "name": "Code"
    },
    {
      "parameters": {
        "jsCode": "// Tomamos la salida del nodo anterior\nlet raw = $json.output;\n\n// Quitamos los backticks y el lenguaje\nraw = raw.replace(/```json\\n?/, \"\").replace(/```$/, \"\").trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  return []; // si no se puede parsear, no devuelve nada\n}\n\n// Caso cuando no hay licitaciones relevantes\nif (parsed.resultado === 2 || !parsed.licitaciones || parsed.licitaciones.length === 0) {\n  return []; // 🔥 aquí no devuelve nada\n}\n\n// Caso cuando sí hay licitaciones relevantes\nconst listado = parsed.licitaciones\n  .map(l => `• ${l.numero_procedimiento}: ${l.descripcion}`)\n  .join(\"\\n\");\n\nreturn [{\n  json: { mensaje: `Licitaciones relevantes:\\n\\n${listado}` }\n}];\n"
      },
