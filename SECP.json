    {
      "parameters": {
        "jsCode": "// Verificar si $json contiene el array directamente o una propiedad con el array\nconst inputData = Array.isArray($json) ? $json : $json.body || $json.lastRunBatch || null;\n\n// Validar que el array fue encontrado\nif (!inputData || !Array.isArray(inputData)) {\n  throw new Error(\"No se encontró un array válido en el JSON recibido.\");\n}\n\n// Si el array tiene la estructura de 'lastRunBatch', accedemos a su primer elemento\nconst batchData = inputData[0]?.lastRunBatch || inputData;\n\n// Validar que batchData es un array\nif (!Array.isArray(batchData)) {\n  throw new Error(\"'lastRunBatch' debe ser un array o no se encontró.\");\n}\n\n// Crear una lista de elementos para enviar al loop\nconst items = batchData.map((item) => {\n  return {\n    json: item, // Cada elemento será un objeto JSON individual\n  };\n});\n\n// Retornar los elementos procesados\nreturn items;\n"
      },
