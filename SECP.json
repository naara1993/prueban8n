        "jsCode": "// Obtener el número de procedimiento y la descripción del elemento actual\nconst procedureNumber =\n$('Globalizar').item.json.numero_procedimiento;\nconst description = $('Globalizar').item.json.descripcion;\n// Crear un objeto con los datos actuales\nreturn [\n  {\n    json: {\n      numero_procedimiento: procedureNumber,\n      descripcion: description || \"Descripción no encontrada\"\n    }\n  }\n];\n"
